# ConsentMD API — environment template.
#
# Copy to api/.env and fill in. `install.sh` generates a working api/.env for
# you (with a random JWT secret); this file is the tracked, value-free
# reference for what every key means and which are actually required.
#
# api/.env itself is gitignored (api/.gitignore:8 `.env*`) and has never been
# committed on any ref — verified across `git rev-list --all`. If you are
# picking up an existing checkout, the credentials in it should still be
# treated as compromised and rotated: they were deployed on a public host.
#
# Every key below is validated by api/src/config/config.js at boot. A missing
# required key throws a raw Joi error before the server starts listening.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | test | production
# NOTE: the historical value was `prod`, which is accepted as a deprecated
# alias. It mattered: app.js and the error middleware compared against
# 'production', so with ENV=prod the auth rate limiter and the production
# stack-trace suppression were both silently inactive.
ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# The connection string is ASSEMBLED from the parts below, not read from
# MONGODB_URL. If MONGODB_HOST is exactly `localhost:27011` a plain
# mongodb:// URI is built; anything else gets mongodb+srv:// (Atlas).
# `install.sh --with-mongo` runs a local container on 27011.
MONGODB_URL=mongodb://localhost:27011/consentmd
MONGODB_USERNAME=consentmd
MONGODB_PASSWORD=change-me
MONGODB_HOST=localhost:27011
MONGODB_NAME=consentmd

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Password assigned to identities created by the bootstrap seeder.
COMMON_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Fabric
# ---------------------------------------------------------------------------
# Bootstrap registrar of the org CAs (see the fabric-ca compose `-b admin:adminpw`).
CA_ADMIN_ID=admin
CA_ADMIN_SECRET=adminpw

# The channel is `mychannel` everywhere in code. (README previously said
# `consentchannel`; that was never true.)
BLOCKCHAIN_CHANNEL_NAME=mychannel
BLOCKCHAIN_CHAINCODE_NAME=medicalconsent

# false => the API resolves peers/orderers via the host connection profile and
# needs the /etc/hosts entries install.sh adds. true => container networking.
DOCKER_MODE=false

# ---------------------------------------------------------------------------
# Object storage (off-chain medical files)
# ---------------------------------------------------------------------------
# Files live in S3-compatible storage; only the SHA-256 and the object key go
# on-chain. The evaluation harness uses MinIO locally so that reproducing the
# benchmarks never requires an AWS account.
AWS_ACCESS_KEY=change-me
AWS_SECRET_ACCESS=change-me
AWS_PRIVATE_BUCKET_NAME=change-me
