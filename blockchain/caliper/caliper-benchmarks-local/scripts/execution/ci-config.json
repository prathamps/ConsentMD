{
	"thresholds": {
		"global": {
			"maxLatencyMs": 5000,
			"minTPS": 1,
			"maxErrorRate": 0.05,
			"minSuccessRate": 0.95
		},
		"byFunction": {
			"createPatientRecord": {
				"maxLatencyMs": 3000,
				"minTPS": 5,
				"maxErrorRate": 0.02
			},
			"getRecordById": {
				"maxLatencyMs": 1000,
				"minTPS": 20,
				"maxErrorRate": 0.01
			},
			"grantConsent": {
				"maxLatencyMs": 2000,
				"minTPS": 10,
				"maxErrorRate": 0.02
			},
			"revokeConsent": {
				"maxLatencyMs": 2000,
				"minTPS": 10,
				"maxErrorRate": 0.02
			},
			"findAssetsByQuery": {
				"maxLatencyMs": 2000,
				"minTPS": 15,
				"maxErrorRate": 0.03
			},
			"registerDoctorProfile": {
				"maxLatencyMs": 2500,
				"minTPS": 8,
				"maxErrorRate": 0.02
			}
		},
		"byLoadType": {
			"light": {
				"maxLatencyMs": 2000,
				"minTPS": 5,
				"maxErrorRate": 0.01
			},
			"medium": {
				"maxLatencyMs": 3000,
				"minTPS": 15,
				"maxErrorRate": 0.03
			},
			"heavy": {
				"maxLatencyMs": 5000,
				"minTPS": 30,
				"maxErrorRate": 0.05
			}
		}
	},
	"notifications": {
		"enabled": true,
		"type": "webhook",
		"config": {
			"url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
			"onSuccess": true,
			"onFailure": true,
			"includeMetrics": true
		}
	},
	"publishing": {
		"enabled": true,
		"type": "file",
		"config": {
			"path": "./ci-reports",
			"includeReports": true,
			"includeSummary": true,
			"retention": {
				"enabled": true,
				"maxAge": "30d",
				"maxCount": 100
			}
		}
	},
	"failFast": true,
	"maxRetries": 2,
	"retryDelay": 30000,
	"timeout": 600000,
	"environment": {
		"validation": {
			"required": true,
			"skipNetworkCheck": false
		},
		"cleanup": {
			"beforeRun": true,
			"afterRun": true
		}
	}
}
